# Client only: authenticates requests to Runpod's Queue API.
# Do not pass this file or RUNPOD_API_KEY to the deployed container.
# Local SDK tests do not need a key. Never commit .env.
RUNPOD_API_KEY=

# Optional local worker overrides. Existing environment variables win over .env.
# Keep these commented for Runpod so the image retains its persistent
# /runpod-volume cache paths and CUDA device. Local cache defaults to .model-cache.
# Use cpu explicitly for development on machines without NVIDIA CUDA.
# LAYA_DEVICE=cpu
# MODEL_CACHE_DIR=./.model-cache
# HF_HOME=./.model-cache/huggingface

# The pinned convaiinnovations/laya model is public; HF_TOKEN is not required.
# HF_TOKEN=
