# Required: generate your own secret. Do not commit .env or bake it into Docker.
# Clients send this value in the X-API-Token header.
API_AUTH_TOKEN=

# Optional local overrides. Keep these commented for Docker/Runpod so the
# image retains its persistent /runpod-volume cache paths and CUDA device.
# LAYA_DEVICE=cpu
# MODEL_CACHE_DIR=./.model-cache
# HF_HOME=./.model-cache/huggingface
# PORT=8000

# The pinned convaiinnovations/laya model is public; HF_TOKEN is not required.
# HF_TOKEN=
